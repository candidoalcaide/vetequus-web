---
import Base from './Base.astro';

interface Props { title: string; description: string; updated: string }
const { title, description, updated } = Astro.props;
---
<Base title={`${title} · Vetequus`} description={description}>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">Información legal</p>
      <h1>{title}</h1>
      <p class="meta">Última actualización: {updated}</p>
    </div>
  </section>
  <div class="wrap">
    <div class="prose">
      <slot />
    </div>
  </div>
</Base>
